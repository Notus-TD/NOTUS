        <mxCell id="p1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="262" y="226" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="596" y="372" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1196" y="96" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="842" y="508" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1196" y="232" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1252" y="318" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Fluxo principal: o responsável fica sabendo da falta do filho&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#e51400&quot;&gt;1&lt;/b&gt; O professor faz a chamada no front-end e marca o aluno ausente.&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#e51400&quot;&gt;2&lt;/b&gt; O navegador envia a chamada para a API por HTTPS, com o token JWT; o Caddy encaminha para o Spring Boot, que confere o perfil e o vínculo do professor com a turma.&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#e51400&quot;&gt;3&lt;/b&gt; A API grava a aula e a falta no PostgreSQL (Supabase) e cria a notificação na fila.&lt;br&gt;&lt;b style=&quot;color:#e51400&quot;&gt;4&lt;/b&gt; A requisição fica registrada no Loki (usuário, IP, rota, resultado e tempo), consultável no Grafana Cloud.&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#e51400&quot;&gt;5&lt;/b&gt; O worker de notificações envia o e-mail pelo Resend, com até 3 tentativas.&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#e51400&quot;&gt;6&lt;/b&gt; O responsável recebe o aviso por e-mail e acompanha as faltas e a frequência no portal." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e51400;strokeWidth=2;align=left;verticalAlign=middle;spacing=12;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="20" y="770" width="1520" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
