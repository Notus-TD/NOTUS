# Variáveis de ambiente do backend NOTUS.
# Em produção (Render): cadastre cada uma em Environment. Localmente: copie para .env (que não vai pro git)
# e rode, por exemplo, `docker run --env-file backend/.env ...`.
# Nunca coloque valores reais neste arquivo.

# Perfil do Spring: supabase em produção; h2 (padrão) ou dev localmente.
SPRING_PROFILES_ACTIVE=supabase

# --- Banco (perfil supabase) ---
# Supabase > Connect > Session pooler. Formato JDBC:
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# No pooler o usuário leva o ref do projeto: postgres.<ref-do-projeto>
SUPABASE_DB_USER=postgres.<ref-do-projeto>
SUPABASE_DB_PASSWORD=
# Opcional: update (padrão), validate ou none
# SUPABASE_DDL_AUTO=update

# --- Segurança ---
# Obrigatório no perfil supabase. String aleatória com 32+ caracteres, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=
# Obrigatório no perfil supabase: chave que cifra os segredos do MFA (TOTP) no banco. String aleatória longa.
# Não troque depois que houver usuários com MFA ativo, senão os códigos deles param de valer.
MFA_CHAVE=

# --- Front-end / CORS ---
# Endereço do front publicado (links de convite e de redefinição de senha nos e-mails)
FRONTEND_URL=https://<seu-front>.pages.dev
# Origens que podem chamar a API, separadas por vírgula
CORS_ALLOWED_ORIGINS=https://<seu-front>.pages.dev

# --- E-mail (Resend) ---
RESEND_API_KEY=
# Precisa de domínio verificado no Resend para enviar a qualquer destinatário
# RESEND_REMETENTE=NOTUS <nao-responda@seudominio.com.br>
# Só para demonstração: manda TODOS os e-mails para este endereço (com o Resend sem domínio verificado,
# precisa ser o e-mail dono da conta do Resend). Vazio = desligado.
# RESEND_REDIRECIONAR_PARA=

# --- Opcionais ---
# PORT=8080                       (o Render define sozinho)
# JAVA_OPTS=-XX:MaxRAMPercentage=50 -XX:+UseSerialGC -Xss512k
# JWT_EXPIRATION_MS=3600000       (validade do token: 1 h)
# JPA_SHOW_SQL=false
# SUPABASE_DB_POOL_SIZE=5
# SUPABASE_DB_SCHEMA=notus
# NOTIFICACAO_LOTE=50
# NOTIFICACAO_TAXA_POR_SEGUNDO=20
# NOTIFICACAO_MAX_TENTATIVAS=3
# NOTIFICACAO_WORKER_INTERVALO_MS=600000
# LOGIN_MAX_FALHAS_CONTA=5
# LOGIN_BLOQUEIO_MINUTOS=15
# LOGIN_MAX_FALHAS_IP_POR_MINUTO=20
# O Loki não é configurável: roda dentro da própria imagem, em http://localhost:3100.

# --- Leitura dos logs pelo Grafana Cloud ---
# Senha do acesso externo ao Loki (rota /loki/api/v1/* da API, protegida pelo Caddy).
# Sem ela, o Loki fica inacessível de fora. Use uma senha longa e aleatória:
#   openssl rand -base64 24
LOKI_PASSWORD=
# LOKI_USER=grafana

# --- Só para o perfil dev (Postgres local do docker-compose) ---
# DEV_DB_PASSWORD=
